# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/smart-billiard

# Auth — change in production
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Mock modes — MUST be false in production
MOCK_PAYMENT=true
MOCK_IOT=true

# QPay Mongolia (required when MOCK_PAYMENT=false)
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_CALLBACK_URL=http://localhost:3000/api/payments/qpay/callback

# Seed (local only)
SEED_ADMIN_EMAIL=admin@smartbilliard.mn
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_PASSWORD=User123!
